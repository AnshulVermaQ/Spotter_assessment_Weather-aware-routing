# Local development. Django runs in the same Windows session on port 8010.
VITE_API_BASE_URL=http://127.0.0.1:8010
VITE_USE_LOCAL_API_PROXY=false
# Set to true only when you deliberately want the frontend fixtures.
VITE_USE_MOCKS=false
# For a deployed backend, set this to its HTTPS origin:
# VITE_API_BASE_URL=https://api.example.com
